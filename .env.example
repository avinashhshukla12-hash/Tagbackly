# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign owner session tokens (minimum 16 characters).
# Set a stable value on Render so sessions survive server restarts.
JWT_SECRET=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional persistent cloud database (if using Supabase).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="tagbackly-uploads"

# FIREBASE ADMIN (Server-Side Persistent Firestore + Storage on Render):
# Paste your Firebase Service Account JSON (single line) OR set the split credentials below.
# When configured, TAGBACKLY stores users, items, QR tags, messages, and notifications in Firebase Firestore.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID="tagbackly"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET="tagbackly.firebasestorage.app"

# FIREBASE WEB CONFIG (Client Phone Auth SMS OTP + Invisible reCAPTCHA):
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="tagbackly.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tagbackly"
VITE_FIREBASE_STORAGE_BUCKET="tagbackly.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
