# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign owner session tokens (minimum 16 characters).
# Set a stable value on Render so sessions survive server restarts.
JWT_SECRET=""

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Optional persistent cloud database (recommended on Render).
# When both are set, TAGBACKLY stores users, items, QR tags, messages, and notifications in Supabase
# instead of ephemeral local SQLite.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="tagbackly-uploads"
